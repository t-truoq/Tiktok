{
  "name": "tiktok-affiliate",
  "version": "0.0.0",
  "private": true,
  "description": "Phase 0 source preservation and Phase 1 backend foundation",
  "workspaces": ["apps/api"],
  "scripts": {
    "inventory": "py scripts/phase0/inventory.py",
    "test:phase0": "node --test tests/phase0/*.test.cjs",
    "baseline:build": "node scripts/phase0/source-baseline.cjs",
    "phase2:preview": "node scripts/phase0/prepare-schema-preview.cjs",
    "phase2:prepare": "node scripts/phase2/prepare-official-migration.cjs",
    "phase2:preflight": "node scripts/phase2/preflight-readonly.cjs",
    "phase2:dry-run": "node scripts/phase2/preservation.cjs",
    "gate0:finalize": "node scripts/phase0/finalize-gate0.cjs",
    "build": "npm run build --workspace apps/api",
    "test:phase1": "npm run test --workspace apps/api",
    "prisma:validate": "npm run prisma:validate --workspace apps/api",
    "start:api": "npm run start --workspace apps/api",
    "start:prod": "node apps/api/dist/main.js",
    "start:prod:verify": "node scripts/phase2/verify-start-prod.cjs",
    "db:verify": "node apps/api/dist/verify-db.js",
    "health:verify": "node apps/api/scripts/verify-health.cjs"
  },
  "engines": {"node": ">=24 <25"}
}
