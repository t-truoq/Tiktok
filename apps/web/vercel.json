{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://tiktok-6kwu.onrender.com/api/v1/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/api/v1/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
