+// truonglt V9.2 PERFORMANCE start
+// Business logic and calculation functions remain exactly as V9.1.
+// Only Sheets I/O is batched. No cache, no new storage schema.
+function updateHeaderTotals(sheet) {
+  if (!sheet) return;
+  const sums = {paid:0,unpaid:0,sampleTotal:0,endTotal:0,profit:0,sampleQty:0,endQty:0,refund:0,missing:0,review:0};
+  const seen = new Set();
+  const lastRow = sheet.getLastRow();
+  const count = Math.max(0, lastRow - CFG.DATA_START_ROW + 1);
+  const sourceRange = count ? sheet.getRange(CFG.DATA_START_ROW,1,count,CFG.COL.NOTE) : null;
+  const values = sourceRange ? sourceRange.getValues() : [];
+  const displays = sourceRange ? sourceRange.getDisplayValues() : [];
+  const outputs = []; // Only unique, non-empty root rows; never overwrite other rows.
+
+  for (let i=0; i<count; i++) {
+    const row = CFG.DATA_START_ROW+i;
+    const d = affiliateRowFromArraysV92(values[i],displays[i]);
+    if (!d.name) continue;
+    const k = normalizeRootName(d.name);
+    if (seen.has(k)) continue;
+    seen.add(k);
+    const r = loadRecord(d.name);
+    if (!r) throw Error('Không đọc được record tại dòng '+row+': '+d.name);
+    ensureRecord(r);
+    if (syncCurrentOrder91(r,d)) saveRecord(d.name,r);
+    const p = getPaymentSummaryForRecord(r), refund = getRefundEligible91(r);
+    ['paid','unpaid','sampleTotal','endTotal','missing','review'].forEach(x=>sums[x]+=p[x]);
+    sums.refund += refund.total;
+    sums.sampleQty += Number(r.qty)||0;
+    sums.endQty += getEndSellQtyTotal(r);
+    sums.profit += calculateProjectedProfit(r);
+    outputs.push({row,values:[p.paid,p.unpaid,refund.total],
+      notes:['',p.missing||p.review?'TẠM TÍNH: '+p.missing+' lượt thiếu giá, '+p.review+' lượt V9 cần đối soát':'',
+        refund.missing?'Thiếu '+refund.missing+' giá Sample tương ứng End đã nhận':'']});
+  }
+
+  // Preserve cells belonging to empty/duplicate rows: batch only adjacent processed rows.
+  for(let i=0;i<outputs.length;){
+    let j=i+1;
+    while(j<outputs.length && outputs[j].row===outputs[j-1].row+1) j++;
+    const group=outputs.slice(i,j);
+    const rg=sheet.getRange(group[0].row,CFG.COL.PAID_TOTAL,group.length,3);
+    // Some native Sheets Tables may disallow a multi-row write.
+    // Fall back to the exact original row-scoped API in that case.
+    try {
+      rg.setValues(group.map(x=>x.values));
+    } catch (batchError) {
+      if (group.length===1) throw batchError;
+      group.forEach(x=>sheet.getRange(x.row,CFG.COL.PAID_TOTAL,1,3).setValues([x.values]));
+    }
+    // Set notes only in Q:R; leave P notes unchanged, as in V9.1.
+    try {
+      sheet.getRange(group[0].row,CFG.COL.UNPAID_TOTAL,group.length,2)
+        .setNotes(group.map(x=>[x.notes[1],x.notes[2]]));
+    } catch (noteError) {
+      if (group.length===1) throw noteError;
+      group.forEach(x=>{
+        sheet.getRange(x.row,CFG.COL.UNPAID_TOTAL).setNote(x.notes[1]);
+        sheet.getRange(x.row,CFG.COL.REFUND_TOTAL).setNote(x.notes[2]);
+      });
+    }
+    i=j;
+  }
+  // Keep all total-row addresses, order, business formula and formatting calls unchanged.
+  const set=(c,v)=>sheet.getRange(CFG.TOTAL_ROW,c).setValue(v);
+  set(1,sums.sampleTotal+sums.endTotal);
+  set(CFG.COL.PRICE,sums.sampleTotal);
+  set(CFG.COL.END_PRICE,sums.endTotal);
+  set(CFG.COL.QTY,sums.sampleQty);
+  set(CFG.COL.SELL_END_QTY,sums.endQty);
+  set(CFG.COL.PROFIT,sums.profit);
+  set(CFG.COL.PAID_TOTAL,sums.paid);
+  set(CFG.COL.UNPAID_TOTAL,sums.unpaid);
+  set(CFG.COL.REFUND_TOTAL,sums.refund);
+  sheet.getRange(CFG.TOTAL_ROW,2).setValue('Total');
+  stylePaymentSummary(sheet);
+  sheet.getRange('P2').setNote(sums.missing||sums.review?
+    'TẠM TÍNH: '+sums.missing+' lượt thiếu giá, '+sums.review+' lượt cần đối soát':'');
+}
+
+// Exact field mapping of original readRow(), now operating on already-fetched arrays.
+function affiliateRowFromArraysV92(v,d) {
