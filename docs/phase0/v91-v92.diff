+    status:String(d[c.STATUS-1]||'').trim(),
+    wholesale:v[c.WHOLESALE-1],qty:v[c.QTY-1],
+    sellEnd:v[c.SELL_END-1],sellEndQty:v[c.SELL_END_QTY-1],
+    profit:v[c.PROFIT-1],note:String(d[c.NOTE-1]||'').trim()
+  };
+}
