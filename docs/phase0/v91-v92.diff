+// truonglt V9.2 READ-ONLY VERIFY start
+// Run from Apps Script editor. Does not touch cells, records or triggers.
+function verifyAffiliateV92ReadOnly() {
+  const sheet=getMainSheet();
+  if(!sheet) throw Error('Không thấy Trang tính2');
+  const lastRow=sheet.getLastRow();
+  const count=Math.max(0,lastRow-CFG.DATA_START_ROW+1);
+  if(!count) return {products:0,invalid:0};
+  const range=sheet.getRange(CFG.DATA_START_ROW,1,count,CFG.COL.NOTE);
+  const values=range.getValues(), displays=range.getDisplayValues();
+  const seen=new Set(), problems=[];
+  const sums={paid:0,unpaid:0,refund:0,profit:0};
+  for(let i=0;i<count;i++){
+    const d=affiliateRowFromArraysV92(values[i],displays[i]);
+    if(!d.name)continue;
+    const key=normalizeRootName(d.name);
+    if(seen.has(key))continue;seen.add(key);
+    const r=loadRecord(d.name);
+    if(!r){problems.push('Không có record: '+d.name);continue;}
+    const p=getPaymentSummaryForRecord(r), refund=getRefundEligible91(r);
+    sums.paid+=p.paid;sums.unpaid+=p.unpaid;
+    sums.refund+=refund.total;sums.profit+=calculateProjectedProfit(r);
+    // Compare financial identity only when all price slots exist.
+    if(p.missing===0 && Math.abs((p.paid+p.unpaid)-p.incurred)>0.000001)
+      problems.push('Công nợ không cân: '+d.name);
+  }
+  const report={products:seen.size,invalid:problems.length,problems,totals:sums};
+  Logger.log(JSON.stringify(report));
+  return report;
+}
+// truonglt V9.2 READ-ONLY VERIFY end
